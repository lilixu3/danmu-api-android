/tools/

# App-owned enhanced outbound source; generated ABI binaries stay local.
!/runtime/outbound/
/runtime/outbound/*
!/runtime/outbound/src/
!/runtime/outbound/README.md
!/runtime/outbound/LICENSE
!/runtime/outbound/UPSTREAM
